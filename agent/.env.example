#Server
AGENT_API_URL=http://localhost:3000

#Auth
AGENT_KEY_CREDENTIALS= #A revocable per-laptop key, not a login

#Project
AGENT_PROJECT_ID=incidentiq
#example relative path
AGENT_PROJECT_ROOT=/Document/projects/incidentiq #the scanner reads <root>/package.json and <root>/server/db/migrations

#Scanning
AGENT_PORTS=5173,3000
AGENT_SCAN_INTERVAL_S=30 #debounces the private card x10
AGENT_PROBE_TIMEOUT_MS=2000 #The maximum time in milliseconds a system will wait for an agent probe to respond.